# Public: included in the app bundle. Never put secrets here.
# USB phone: adb -s PHONE_SERIAL reverse tcp:8080 tcp:8080
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
# Wi-Fi: replace with the computer LAN IP (phone and computer on the same network).
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# Public token for the map only. Never use backend sk.* credentials here.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
