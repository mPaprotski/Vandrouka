ENV=development
HTTP_PORT=8080
POSTGRES_DSN=postgres://postgres:postgres@localhost:25432/vandrouka?sslmode=disable
MAPBOX_URL=https://api.mapbox.com
MAPBOX_ACCESS_TOKEN=

PLANNER_WALK_PENALTY=0.5
PLANNER_COST_PENALTY=0.1
PLANNER_UNVERIFIED_PENALTY=0.5

# Local go run from backend/; Docker Compose overrides this with /app/data
DATA_DIR=../../data

ROUTE_REQUESTS_PER_MINUTE=6
ROUTE_BURST=2
ROUTE_MAX_CONCURRENT=2
ROUTE_MAX_CLIENTS=4096
ROUTE_CLIENT_TTL_SECONDS=600
