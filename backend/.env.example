ENV=development
HTTP_PORT=8080
POSTGRES_DSN=postgres://postgres:postgres@localhost:25432/vandrouka?sslmode=disable
MAPBOX_URL=https://api.mapbox.com
MAPBOX_ACCESS_TOKEN=

PLANNER_WALK_PENALTY=0.5
PLANNER_COST_PENALTY=0.1
PLANNER_UNVERIFIED_PENALTY=0.5

# Local go run from backend/; Docker Compose overrides this with /app/data
DATA_DIR=../../data

ROUTE_REQUESTS_PER_MINUTE=6
ROUTE_BURST=2
ROUTE_MAX_CONCURRENT=2
ROUTE_MAX_CLIENTS=4096
ROUTE_CLIENT_TTL_SECONDS=600

# Lifetime for newly issued access sessions (Go duration, e.g. 24h or 72h)
AUTH_ACCESS_TTL=24h

# Private photo storage. Docker overrides endpoint with http://minio:9000.
MEDIA_S3_ENDPOINT=http://127.0.0.1:29000
MEDIA_S3_BUCKET=vandrouka-visit-photos
MEDIA_S3_ACCESS_KEY=vandrouka-local
MEDIA_S3_SECRET_KEY=replace-with-a-random-local-secret-at-least-16-chars

# Absolute refresh-family lifetime; rotation does not extend this deadline.
AUTH_REFRESH_TTL=720h

# GPS confirmation thresholds (server-side only)
VISIT_RADIUS_M=50
VISIT_ACCURACY_M=30
VISIT_MAX_AGE=120s
VISIT_FUTURE_SKEW=30s
